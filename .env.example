# Storage: leave empty to use SQLite at MF_SQLITE_PATH
MF_DATABASE_URL=postgresql://forge:forge@localhost:5432/memoryforge
MF_SQLITE_PATH=runs/memoryforge.sqlite3

# LLM backend: simulated | openai_compatible | hf_local
MF_LLM_BACKEND=simulated
MF_LLM_BASE_URL=http://localhost:11434/v1
MF_LLM_MODEL=qwen2.5-coder:7b
MF_LLM_API_KEY=
MF_HF_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct

# Embeddings: auto | minilm | hash   (MF_OFFLINE=1 forces hash)
MF_EMBEDDER=auto

# Agent
MF_MAX_TRIALS=3
MF_TOP_K=3
MF_SANDBOX_TIMEOUT=6
